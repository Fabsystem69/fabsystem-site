generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AssetType {
  VEHICLE
  BOAT
  OTHER
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum ServiceType {
  INTERVENTION
  FORMATION
  AUDIT
  CONSEIL
}

enum DeliveryMode {
  ONSITE
  REMOTE
}

enum RemiseStatus {
  DRAFT
  SENT
  APPLIED
}

model Customer {
  id           String    @id @default(cuid())
  name         String
  email        String?
  phone        String?
  address      String?
  assetType    AssetType @default(OTHER)
  assetBrand   String?
  assetModel   String?
  registration String?
  odometerKm   Int?
  engineHours  Int?
  quotes       Quote[]
  invoices     Invoice[]
  remises      Remise[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([registration])
}

model Quote {
  id                      String       @id @default(cuid())
  number                  String       @unique
  status                  QuoteStatus  @default(DRAFT)
  customerId              String
  customer                Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issueDate               DateTime
  validUntil              DateTime?
  notes                   String?
  subtotal                Int
  tax                     Int
  total                   Int
  serviceType             ServiceType  @default(INTERVENTION)
  deliveryMode            DeliveryMode @default(ONSITE)
  serviceDate             DateTime?
  signedAt                DateTime?
  signedName              String?
  agreementChecked        Boolean      @default(false)
  signatureDataUrl        String?
  signatureTokenHash      String?
  signatureTokenExpiresAt DateTime?
  signatureIp             String?
  signatureUserAgent      String?
  sourceInvoice           Invoice?     @relation("QuoteToInvoice")
  items                   QuoteItem[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([customerId])
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  position    Int

  @@index([quoteId])
}

model Invoice {
  id                String        @id @default(cuid())
  number            String        @unique
  status            InvoiceStatus @default(DRAFT)
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issueDate         DateTime
  dueDate           DateTime?
  currency          String        @default("EUR")
  customerReference String?
  projectReference  String?
  serviceReference  String?
  notes             String?
  subtotal          Int
  tax               Int
  total             Int
  serviceType       ServiceType   @default(INTERVENTION)
  deliveryMode      DeliveryMode  @default(ONSITE)
  serviceDate       DateTime?
  paidAt            DateTime?
  paymentMethod     String?
  paymentRef        String?
  sourceQuoteId     String?       @unique
  sourceQuote       Quote?        @relation("QuoteToInvoice", fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  items             InvoiceItem[]
  remises           Remise[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([customerId])
  @@index([paidAt])
  @@index([sourceQuoteId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  position    Int

  @@index([invoiceId])
}

model Remise {
  id         String       @id @default(cuid())
  number     String       @unique
  status     RemiseStatus @default(DRAFT)
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId  String?
  invoice    Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount     Int
  reason     String?
  date       DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([customerId])
  @@index([invoiceId])
}

model ItemTemplate {
  id                    String   @id @default(cuid())
  label                 String   @unique
  unit                  String?
  defaultUnitPriceCents Int?
  lastUsedAt            DateTime @default(now())
  useCount              Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model DocumentSequence {
  key          String   @id
  prefix       String
  year         Int
  currentValue Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([prefix, year])
}

enum EbookOrderStatus {
  PENDING
  PAID
  GENERATING
  READY
  FAILED
}

model EbookOrder {
  id                    String           @id @default(cuid())
  email                 String
  name                  String
  stripeSessionId       String           @unique
  stripePaymentIntentId String?
  status                EbookOrderStatus @default(PENDING)
  desktopBlobPath       String?
  pocketBlobPath        String?
  downloadCount         Int              @default(0)
  emailSentAt           DateTime?
  emailError            String?
  failureReason         String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([email])
}
