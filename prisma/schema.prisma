  label                 String   @unique
  unit                  String?
  defaultUnitPriceCents Int?
  lastUsedAt            DateTime @default(now())
  useCount              Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model DocumentSequence {
  key          String   @id
  prefix       String
  year         Int
  currentValue Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([prefix, year])
}

model Product {
  id                       String                  @id @default(cuid())
  slug                     String                  @unique
  name                     String
  shortDescription         String?
  description              String?
  status                   ProductStatus           @default(DRAFT)
  productType              ProductType
  purchaseMode             PurchaseMode            @default(BUY_NOW)
  featuredImage            String?
  // Nombre de jours d'accès Éditeur Plus offerts à l'achat de ce produit
  // (null = aucun bonus). Configurable depuis le dashboard catalogue plutôt
  // que codé en dur par slug — un même mécanisme sert aussi bien un
  // accompagnement qu'un ebook. Lu par grantPrestationsBenefitsForOrder.
  includedEditorAccessDays Int?
  prices                   ProductPrice[]
  assets                   ProductAsset[]
  cartItems                CartItem[]
  orderItems               OrderItem[]
  downloadGrants           DownloadGrant[]
  resourceGrants           CustomerResourceGrant[]
  discountCodes            DiscountCode[]
  discountRedemptions      DiscountRedemption[]
  bundleItems              BundleItem[]            @relation("BundleProductItems")
  includedInBundles        BundleItem[]            @relation("IncludedProductItems")
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([status])
  @@index([productType])
  @@index([purchaseMode])
}

model ProductPrice {
  id                   String      @id @default(cuid())
  productId            String
  product              Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  currency             String      @default("EUR")
  unitAmountCents      Int
  compareAtAmountCents Int?
  status               PriceStatus @default(ACTIVE)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([productId])
  @@index([status])
}

model DigitalAsset {
  id             String                  @id @default(cuid())
  provider       DigitalAssetProvider    @default(SUPABASE)
  bucket         String
  path           String
  filename       String
  contentType    String
  sizeBytes      Int
  version        String?
  status         DigitalAssetStatus      @default(DRAFT)
  products       ProductAsset[]
  downloadGrants DownloadGrant[]
  resourceGrants CustomerResourceGrant[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([bucket, path])
  @@index([status])
  @@index([provider])
}

model ProductAsset {
  productId String
  assetId   String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset     DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@id([productId, assetId])
  @@index([assetId])
}

model BundleItem {
  bundleProductId   String
  includedProductId String
  bundleProduct     Product  @relation("BundleProductItems", fields: [bundleProductId], references: [id], onDelete: Cascade)
  includedProduct   Product  @relation("IncludedProductItems", fields: [includedProductId], references: [id], onDelete: Restrict)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  @@id([bundleProductId, includedProductId])
  @@index([includedProductId])
}

model Cart {
  id            String     @id @default(cuid())
  status        CartStatus @default(ACTIVE)
  sessionId     String?    @unique
  customerEmail String?
  items         CartItem[]
  order         Order?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([customerEmail])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique
  status              OrderStatus          @default(DRAFT)
  customerId          String?
  discountCodeId      String?
  customerEmail       String
  customerName        String?
  currency            String               @default("EUR")
  subtotalCents       Int
  discountTotalCents  Int                  @default(0)
  totalCents          Int
  cartId              String?              @unique
  // v2.1 : renseigne uniquement pour un Order dont l'item est un produit
  // SCHEMA_UNLOCK — permet au webhook Stripe de savoir quel Project
  // deverrouiller a la confirmation du paiement (les metadata Stripe ne sont
  // jamais persistees, voir stripe-webhook-commerce.ts).
  projectId           String?
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cart                Cart?                @relation(fields: [cartId], references: [id], onDelete: SetNull)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountCode        DiscountCode?        @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]
  downloadGrants      DownloadGrant[]
  discountRedemptions DiscountRedemption[]
  dossierClient       DossierClient?
  coachingProject     CoachingProject?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  paidAt              DateTime?
  cancelledAt         DateTime?
  refundedAt          DateTime?

  @@index([status])
  @@index([customerId])
  @@index([customerEmail])
  @@index([discountCodeId])
  @@index([projectId])
  @@index([createdAt])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  productId       String
  productSlug     String
  productName     String
  productType     ProductType
  quantity        Int             @default(1)
  currency        String          @default("EUR")
  unitAmountCents Int
  lineTotalCents  Int
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  downloadGrants  DownloadGrant[]
  createdAt       DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                      String          @id @default(cuid())
  orderId                 String
  provider                PaymentProvider @default(STRIPE)
  status                  PaymentStatus   @default(PENDING)
  amountCents             Int
  currency                String          @default("EUR")
  stripeCheckoutSessionId String?         @unique
  stripePaymentIntentId   String?
  stripeCustomerId        String?
  rawProviderStatus       String?
  order                   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  succeededAt             DateTime?
  failedAt                DateTime?
  refundedAt              DateTime?

  @@index([orderId])
  @@index([status])
  @@index([provider])
  @@index([stripePaymentIntentId])
}

model DownloadGrant {
  id               String              @id @default(cuid())
  orderId          String
  orderItemId      String
  productId        String
  assetId          String
  customerEmail    String
  status           DownloadGrantStatus @default(ACTIVE)
  downloadCount    Int                 @default(0)
  maxDownloads     Int                 @default(10)
  expiresAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  revokedAt        DateTime?
  lastDownloadedAt DateTime?
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem        OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  asset            DigitalAsset        @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, assetId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([assetId])
  @@index([customerEmail])
  @@index([status])
  @@index([expiresAt])
}

// Octroi manuel d'une ressource numérique par l'admin (ex. ebook offert
// pour un SAV) — délibérément indépendant d'Order/OrderItem (contrairement
// à DownloadGrant ci-dessus) car il n'y a pas de commande réelle : les FK
// pointent directement sur Customer, sans transiter par un Order fictif à
// 0€ qui polluerait les stats de commandes.
model CustomerResourceGrant {
  id               String              @id @default(cuid())
  customerId       String
  productId        String
  assetId          String
  note             String?
  status           DownloadGrantStatus @default(ACTIVE)
  downloadCount    Int                 @default(0)
  maxDownloads     Int                 @default(10)
  expiresAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  revokedAt        DateTime?
  lastDownloadedAt DateTime?
  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  asset            DigitalAsset        @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([productId])
  @@index([assetId])
  @@index([status])
  @@index([expiresAt])
}

model DiscountCode {
  id             String               @id @default(cuid())
  code           String               @unique
  status         DiscountCodeStatus   @default(ACTIVE)
  type           DiscountCodeType
  amountOffCents Int?
  percentOff     Int?
  currency       String               @default("EUR")
  maxRedemptions Int                  @default(1)
  redeemedCount  Int                  @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  productId      String?
  customerEmail  String?
  reason         String?
  product        Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  orders         Order[]
  redemptions    DiscountRedemption[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status])
  @@index([productId])
  @@index([customerEmail])
  @@index([expiresAt])
}

model DiscountRedemption {
  id                    String       @id @default(cuid())
  discountCodeId        String
  orderId               String
  customerEmail         String
  productId             String?
  amountDiscountedCents Int
  redeemedAt            DateTime     @default(now())
  discountCode          DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Restrict)
  order                 Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product               Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([discountCodeId, orderId])
  @@index([discountCodeId])
  @@index([orderId])
  @@index([customerEmail])
  @@index([productId])
}

model MagicLoginToken {
  id         String                @id @default(cuid())
  customerId String
  email      String
  tokenHash  String                @unique
  status     MagicLoginTokenStatus @default(ACTIVE)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime              @default(now())
  customer   Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model CustomerSession {
  id               String                @id @default(cuid())
  customerId       String
  sessionTokenHash String                @unique
  status           CustomerSessionStatus @default(ACTIVE)
  expiresAt        DateTime
  createdAt        DateTime              @default(now())
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  customer         Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
}

enum TestimonialCustomerType {
  VAN
  CAMPING_CAR
  BOAT
  OTHER
}

model Testimonial {
  id                 String                  @id @default(cuid())
  displayName        String
  customerType       TestimonialCustomerType @default(OTHER)
  vehicleModel       String?
  region             String?
  rating             Int
  quote              String
  relatedOffer       String?
  isVerifiedPurchase Boolean                 @default(false)
  isPublished        Boolean                 @default(false)
  isFeatured         Boolean                 @default(false)
  displayOrder       Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([isPublished])
  @@index([isFeatured])
  @@index([displayOrder])
}

enum TrialAccessCodeStatus {
  ACTIVE
  REVOKED
}

// v2.1 : code promo distribue (communaute, groupes) donnant un acces
// illimite temporaire a l'editeur de schema, sans paiement — distinct de
// DiscountCode qui reduit un prix a l'achat. Un code cree une
// CustomerCapability (scope=CUSTOMER, expiresAt=maintenant+durationDays) sur
// tous les projets du compte qui le saisit, jamais l'inverse.
model TrialAccessCode {
  id             String                      @id @default(cuid())
  code           String                      @unique
  capability     String
  durationDays   Int                         @default(7)
  status         TrialAccessCodeStatus       @default(ACTIVE)
  maxRedemptions Int                         @default(1)
  redeemedCount  Int                         @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  reason         String?
  // Les codes issus d'un achat restent lies a leur commande : cela rend la
  // creation idempotente lors d'une relivraison Stripe, sans modifier les
  // codes communautaires existants (sourceOrderId reste nullable).
  sourceOrderId  String?                     @unique
  // Un code commercial ne peut etre active que depuis le compte de l'adresse
  // ayant passe la commande. Les anciens codes restent non nominatifs.
  recipientEmail String?
  redemptions    TrialAccessCodeRedemption[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([status])
  // Restaure par la migration 20260903193000 (recherches nominatives de
  // codes en production) mais jamais reporte ici jusqu'a present — Prisma
  // Migrate le voyait comme un drift et voulait le redropper.
  @@index([recipientEmail])
}

// Un compte ne peut consommer un meme code qu'une fois (@@unique) — un
// visiteur qui recree un compte avec un autre email peut en theorie
// reutiliser le meme code : accepte pour un code promo communautaire (pas de
// verification d'identite), a surveiller cote volumetrie si abus.
model TrialAccessCodeRedemption {
  id         String          @id @default(cuid())
  codeId     String
  code       TrialAccessCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  redeemedAt DateTime        @default(now())

  @@unique([codeId, customerId])
  @@index([customerId])
}

// --- Suivi accompagnement (DossierClient) ---------------------------------
// Suivi de la prestation d'accompagnement achetee (Order-driven) : appel
// decouverte/conseil (statut simple) ou guide/conception (timeline a
// etapes). Sans rapport avec Project/ProjectFollowUpReview, qui suivent
// l'usage de l'editeur de schema — un client peut avoir les deux, sans lien
// entre eux. L'acces inclus (editeur/ebook) n'est jamais duplique ici : lu
// depuis CustomerCapability/DiscountCode (source de verite existante,
// lib/services/prestations-benefits.ts) via getIncludedAccessForCustomer().

// Personnalisation des emails clients depuis le dashboard (retour
// utilisateur : "je veux visualiser et modifier les templates de mail
// client") — une ligne par cle de template (voir lib/email-templates-defaults.ts
// pour la liste des cles et leur contenu par defaut). L'absence de ligne
// pour une cle = contenu par defaut utilise tel quel ; "Reinitialiser"
// supprime simplement la ligne plutot que de restaurer une valeur figee,
// pour que les deux restent toujours synchronises.
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  bodyText  String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum DossierOffre {
  DECOUVERTE
  CONSEIL
  GUIDE
  CONCEPTION
}

enum DossierStatutSimple {
  A_VENIR
  FAIT
}

model DossierClient {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Null pour "decouverte" : jamais de commande (offre gratuite, CTA vers
  // /contact), dossier cree manuellement depuis le dashboard.
  orderId    String?      @unique
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  offre      DossierOffre

  whatsapp String?

  // decouverte / conseil : statut simple, pas de timeline.
  statutSimple DossierStatutSimple?
  compteRendu  String?              @db.Text

  // guide / conception : timeline a etapes fixes par offre (voir
  // lib/dossier-client.ts, meme principe que STEP_TEMPLATES dans
  // lib/project-follow-up.ts). Cle d'etape en String, jamais un enum Prisma,
  // pour rester coherent avec Project.followUpStepOverride.
  etapeActuelle  String?
  etapeOverride  String?
  iterationCount Int     @default(0)

  dateLivraison           DateTime?
  consentementPartage     Boolean   @default(false)
  consentementPartageAt   DateTime?
  temoignageDemande       Boolean   @default(false)
  temoignageRecu          Boolean   @default(false)
  // Message de prise de nouvelles J+30 apres livraison (Phase 8) — flag
  // "deja envoye", meme principe que temoignageDemande, pour ne jamais
  // relancer deux fois.
  j30MessageEnvoye        Boolean   @default(false)
  // Preuve durable qu'un avertissement de purge a ete envoye AVEC SUCCES
  // (jamais pose avant tentative) — la purge effective (documents) exige ce
  // champ non nul et suffisamment ancien, en plus de dateLivraison (constat
  // d'audit : un avertissement echoue ne doit jamais etre suivi d'une purge).
  purgeWarningSentAt      DateTime?
  // Preuve durable que l'e-mail de confirmation post-achat a ete envoye AVEC
  // SUCCES — sans ce marqueur, l'existence du dossier a elle seule
  // interrompait tout rejeu webhook Stripe et empechait de reessayer un
  // envoi initial en echec (constat d'audit).
  confirmationEmailSentAt DateTime?

  notesInternes String? @db.Text

  // Formulaire de besoin (lib/prestations-needs.ts) : persiste ici au lieu
  // de ne vivre qu'en metadata Stripe (comportement precedent, toujours en
  // vigueur pour les commandes "pack-", hors perimetre).
  besoinVehicule    String?
  besoinDescription String? @db.Text
  besoinProgress    String?
  besoinDeadline    String?
  besoinAutre       String? @db.Text

  derniereActivite DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  events       DossierEvent[]
  documents    DossierDocument[]
  appointments DossierAppointment[]

  @@index([customerId])
  @@index([offre])
  @@index([derniereActivite])
}

// Journal unique par dossier : couvre a la fois les changements d'etape et
// les iterations (schema/verification) — un seul historique plutot que deux
// mecanismes paralleles qui pourraient diverger. Meme forme que
// ProjectFollowUpEvent (lib/services/project-follow-up-review.ts).
model DossierEvent {
  id         String        @id @default(cuid())
  dossierId  String
  dossier    DossierClient @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type       String
  fromEtape  String?
  toEtape    String?
  note       String?       @db.Text
  authorName String        @default("FabSystem")
  createdAt  DateTime      @default(now())

  @@index([dossierId, createdAt])
}

model DossierDocument {
  id          String        @id @default(cuid())
  dossierId   String
  dossier     DossierClient @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  filename    String
  bucket      String
  path        String
  contentType String?
  sizeBytes   Int
  uploadedBy  String
  createdAt   DateTime      @default(now())

  @@unique([bucket, path])
  @@index([dossierId, createdAt])
}

// Rendez-vous visio/telephone lies a un dossier (retour utilisateur : "un
// calendrier pour caler les visio... les avoir sur le suivi d'accompagnement
// avec date et duree et un espace pour ecrire un resume"). Un dossier peut
// avoir plusieurs rendez-vous au fil du suivi (cadrage, points d'etape...).
// Alimente le flux ICS prive expose par app/api/calendar/accompagnements.ics
// (abonnement webcal cote iPhone) — jamais l'inverse, ce modele reste la
// seule source de verite, aucun etat calendrier duplique.
model DossierAppointment {
  id              String        @id @default(cuid())
  dossierId       String
  dossier         DossierClient @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  durationMinutes Int           @default(30)
  compteRendu     String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([dossierId])
  @@index([scheduledAt])
}

// --- CRM coaching (prospects Facebook -> clients -> projets electriques) --
// Retour utilisateur : "gerer leur parcours depuis le premier contact
// jusqu'au suivi du coaching dans un seul espace". Volontairement separe de
// DossierClient (offre/etapes fixes/paiement Stripe, deja utilise par
// /dashboard/accompagnements et /mon-compte/mon-accompagnement) : un
// Prospect n'a souvent ni email ni compte, un CoachingProject autorise
// plusieurs projets electriques par client sans etape figee, et le suivi de
// temps achete/consomme + les propositions commerciales n'existent nulle
// part ailleurs. Customer reste l'unique ancre d'identite (jamais de second
// modele "client" redondant) : un "client coaching" est simplement un
// Customer possedant au moins un CoachingProject.

enum ProspectSource {
  MESSENGER
  PAGE_FACEBOOK
  GROUPE_FACEBOOK
  COMMENTAIRE
  PUBLICITE
  // Formulaire de contact du site public (app/api/contact/route.ts) —
  // scenario explicite du plan : "Contact web, panne de notification ->
  // Demande retrouvable et alerte retentable". La demande doit rester
  // retrouvable meme si l'e-mail de notification echoue.
  SITE_WEB
  AUTRE
}

enum ProspectStatus {
  NOUVEAU
  EN_DISCUSSION
  COACHING_PROPOSE
  RESERVE
  GAGNE
  SANS_SUITE
}

model Prospect {
  id     String         @id @default(cuid())
  name   String
  phone  String?
  // Facultatif (retour utilisateur explicite) : beaucoup de contacts
  // Facebook Messenger n'ont pas d'email a ce stade.
  email  String?
  source ProspectSource

  facebookLink      String?
  besoinElectricite String? @db.Text
  notesInternes     String? @db.Text

  status       ProspectStatus @default(NOUVEAU)
  nextAction   String?
  nextActionAt DateTime?

  // Rempli a la conversion reussie en client (voir convertProspectToClient,
  // lib/services/prospect.ts) - garde l'historique au lieu de le perdre.
  // SetNull si le Customer est supprime : le prospect ne doit jamais
  // disparaitre silencieusement pour ca.
  convertedCustomerId String?   @unique
  convertedCustomer   Customer? @relation(fields: [convertedCustomerId], references: [id], onDelete: SetNull)

  derniereActivite DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  events ProspectEvent[]

  @@index([status])
  @@index([nextActionAt])
  @@index([derniereActivite])
}

// Meme principe que DossierEvent : un seul historique d'activite plutot que
// des champs de date eparpilles.
model ProspectEvent {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type       String // "STATUS_CHANGE" | "NOTE"
  fromStatus String?
  toStatus   String?
  note       String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([prospectId, createdAt])
}

// Modeles de reponses Messenger, modifiables depuis le dashboard (retour
// utilisateur : "bouton Copier... premier contact, qualification du besoin,
// presentation du coaching et relance") - seedes une fois via
// ensureDefaultProspectMessageTemplates() (lib/services/prospect.ts), jamais
// via une migration de donnees.
model ProspectMessageTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  body      String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum ClientLevel {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
}

// Fiche d'entretien (FICHE_ENTRETIEN_ET_SUIVI_COACHING.md) : "une action
// comporte un libelle, une personne attendue - vous ou le client -, une
// date eventuelle et un etat" (PLAN_AMELIORATION_CRM_FABSYSTEM.md §4.3).
enum CoachingResponsible {
  COACH
  CLIENT
}

enum CoachingProjectStatus {
  A_DEMARRER
  EN_COURS
  EN_ATTENTE
  TERMINE
}

model CoachingProject {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  title        String
  description  String?               @db.Text
  objectifs    String?               @db.Text
  niveauClient ClientLevel?
  status       CoachingProjectStatus @default(A_DEMARRER)

  // Cloture (PLAN_AMELIORATION_CRM_FABSYSTEM.md §4.6) : "resultat obtenu,
  // documents remis, points restants, situation commerciale, eventuel
  // rendez-vous ulterieur" - une courte synthese, jamais un formulaire
  // disproportionne. Distincte de `status` (qui peut repasser a EN_COURS a
  // la reprise) : clotureAt/clotureResume gardent la DERNIERE synthese de
  // cloture meme apres une reprise - "cloturer, archiver et supprimer sont
  // trois operations distinctes", la reprise ne doit jamais modifier
  // retroactivement le livrable precedent (l'historique complet reste dans
  // CoachingProjectEvent, jamais ecrase ici).
  clotureResume String?   @db.Text
  clotureAt     DateTime?

  // Bilan interne de cloture (PLAN_EXECUTION_CRM_CLAUDE.md §4 lot E :
  // "bilan ce qui a aide / ce qui a pris du temps / a changer pour le
  // prochain client") - distinct de clotureResume : jamais expose au
  // client, sert uniquement a Fabien pour ameliorer son offre au fil des
  // accompagnements. Meme regle que clotureResume/clotureAt : une reprise
  // ne les efface jamais retroactivement.
  bilanCeQuiAAide        String? @db.Text
  bilanCeQuiAPrisDuTemps String? @db.Text
  bilanAAmeliorer        String? @db.Text

  // "Historique du suivi" delibrement non duplique dans un journal a part :
  // c'est la suite chronologique des comptes-rendus de CoachingSession, deja
  // horodatee. questionsEnAttente/actionsAPreparer restent de simples blocs
  // texte en v1 (pas de sous-checklist dediee) - CoachingActionItem couvre
  // deja le vrai suivi a echeance/statut.
  questionsEnAttente String? @db.Text
  actionsAPreparer   String? @db.Text
  notesInternes      String? @db.Text

  // --- Dossier client evolutif van (docs/_local/Prompt_Claude_Fabsystem_Dossier_Van.md) ---
  // Espace REELEMENT partage entre coach et client (retour utilisateur
  // explicite) : ces champs sont modifiables des deux cotes
  // (app/mon-compte/mon-van et app/dashboard/crm/projects), jamais reserves
  // a un role. Volontairement des String? plutot que des enums fermes :
  // "une donnee inconnue ne vaut jamais zero", un client doit toujours
  // pouvoir repondre "je ne sais pas" ou "a definir avec Fabsystem" sans
  // qu'une migration soit necessaire pour ajouter une option.

  // Etape 1 - Projet et vehicule
  vehicleBrand         String?
  vehicleModel         String?
  vehicleYear          String?
  vehicleEngine        String?
  vehicleFormat        String?
  vehicleDimensions    String?
  registrationCountry  String?
  usageCountry         String?
  homologationNotes    String?  @db.Text
  projectStage         String? // idee / vehicule achete / amenagement en cours / installation partielle / a modifier
  whoDoesTheWork       String?
  coachingTopics       String?  @db.Text
  threePriorities      String?  @db.Text
  startDeadline        String?
  materialBudgetCents  Int?
  laborBudgetCents     Int?
  // Marqueur de concurrence pour CE bloc de champs uniquement (pas le
  // updatedAt global de la ligne) : coach et client peuvent modifier des
  // sections differentes en meme temps sans se bloquer mutuellement -
  // seule une modification concurrente de LA MEME section doit etre
  // detectee (retour utilisateur : "eviter d'ecraser silencieusement").
  vehicleInfoUpdatedAt DateTime @default(now())

  // Etape 2 - Usages et recharge
  travelerCount          String?
  usagePattern           String? // week-ends / vacances / longs voyages / vie a l'annee
  remoteWorkNotes        String?  @db.Text
  seasonsRegionsNotes    String?  @db.Text
  parkingExposure        String?
  daysWithoutRecharge    String?
  minAutonomyNoRecharge  String?
  criticalDevicesWhenLow String?  @db.Text
  drivingHabits          String?  @db.Text
  shorePowerAvailability String?
  solarPreference        String? // souhaite / non souhaite / a etudier
  solarMounting          String? // fixe / portable
  solarRoofSpaceNotes    String?  @db.Text
  otherEnergySources     String?  @db.Text
  // Notes narratives seulement : le suivi structure des equipements a venir
  // se fait deja via CoachingDevice.phase = FUTUR, jamais duplique ici.
  plannedEquipmentNotes  String?  @db.Text
  usagesUpdatedAt        DateTime @default(now())

  // Etape 5 - Implantation (contexte partage ; le registre de circuits
  // detaille, lui, reste dans CoachingCircuit, exclusivement coach).
  implantationNotes       String?  @db.Text
  ventilationConstraints  String?  @db.Text
  outletsLightingNotes    String?  @db.Text
  vehicleElectricalNotes  String?  @db.Text
  vehicleElectricalSource String?
  implantationUpdatedAt   DateTime @default(now())

  // Fiche d'entretien / accord commercial specifique a ce client
  // (FICHE_ENTRETIEN_ET_SUIVI_COACHING.md §2 "Synthese et proposition") —
  // distinct de `offre` (le produit/SKU achete) : ici, ce qui est REELEMENT
  // convenu avec CE client (les tarifs evoluent, cf. PLAN_AMELIORATION_CRM_FABSYSTEM.md).
  // resumePartage est le SEUL champ de ce bloc explicitement destine au
  // client (meme convention que `objectifs`, deja rendu sur
  // /mon-compte/mon-van) ; les autres restent prives par simple omission
  // des ecrans client, comme `notesInternes`.
  preoccupations     String?  @db.Text
  accordPrixCents    Int?
  accordPerimetre    String?  @db.Text
  accordMiseAuPropre String?
  resumePartage      String?  @db.Text
  entretienUpdatedAt DateTime @default(now())

  // Relecture (retour utilisateur : bouton "Envoyer pour relecture", espace
  // partage cote et coach cote client) - s'applique aux champs partages
  // ci-dessus et aux CoachingDevice/CoachingDeviceUsage du projet, jamais a
  // la synthese technique (reservee coach, jamais soumise a relecture).
  readyForReviewAt      DateTime?
  lastReviewedAt        DateTime?
  hasChangesSinceReview Boolean   @default(false)

  // --- Reprise DossierClient (plan de consolidation, docs/03-DATABASE.md) ---
  // Champs additifs pour absorber DossierClient sans perdre son historique
  // commercial/de suivi. Nullable/valeurs par defaut neutres : un
  // CoachingProject cree hors achat (CRM pur) garde tout ce bloc a sa valeur
  // neutre, jamais une valeur inventee a la reprise.
  orderId                 String?              @unique
  order                   Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  offre                   DossierOffre?
  whatsapp                String?
  statutSimple            DossierStatutSimple?
  compteRendu             String?              @db.Text
  etapeActuelle           String?
  etapeOverride           String?
  iterationCount          Int                  @default(0)
  dateLivraison           DateTime?
  consentementPartage     Boolean              @default(false)
  consentementPartageAt   DateTime?
  temoignageDemande       Boolean              @default(false)
  temoignageRecu          Boolean              @default(false)
  j30MessageEnvoye        Boolean              @default(false)
  purgeWarningSentAt      DateTime?
  confirmationEmailSentAt DateTime?
  besoinVehicule          String?
  besoinDescription       String?              @db.Text
  besoinProgress          String?
  besoinDeadline          String?
  besoinAutre             String?              @db.Text

  // --- Support multi-vehicules (PROMPT_CLAUDE_APRES_FUSION_SUPPORTS.md) ---
  // Reutilise l'enum existant de l'editeur (plus granulaire que
  // Customer.assetType/AssetType, qui a un sens different : fiche profil
  // generale, pas le support d'un accompagnement precis). Nullable =
  // inconnu ; aucun ancien dossier n'est reecrit automatiquement en "VAN".
  assetType ProjectAssetType?

  // --- Lien vers l'editeur de schema existant (NOTE_CLAUDE_REUTILISER_EDITEUR_EXISTANT.md) ---
  // Aucun second editeur : ce champ rattache le dossier a un Project/
  // ProjectSchema deja existant plutot que d'en dupliquer le contenu ici.
  // 1:1 optionnel (voir docs/03-DATABASE.md §4 pour la cardinalite a
  // reconfirmer si un besoin de plusieurs schemas actifs apparait).
  linkedProjectId String?  @unique
  linkedProject   Project? @relation(fields: [linkedProjectId], references: [id], onDelete: SetNull)

  derniereActivite DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  documents       CoachingProjectDocument[]
  sessions        CoachingSession[]
  actions         CoachingActionItem[]
  proposals       CoachingProposal[]
  scenarios       CoachingScenario[]
  devices         CoachingDevice[]
  materials       CoachingMaterial[]
  circuits        CoachingCircuit[]
  schemaRevisions CoachingSchemaRevision[]
  events          CoachingProjectEvent[]

  @@index([customerId])
  @@index([status])
  @@index([derniereActivite])
}

// Meme pattern que DossierDocument (lib/server/dossier-storage.ts, Vercel
// Blob prive) - voir lib/server/coaching-project-storage.ts.
model CoachingProjectDocument {
  id          String          @id @default(cuid())
  projectId   String
  project     CoachingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename    String
  bucket      String
  path        String
  contentType String?
  sizeBytes   Int
  uploadedBy  String
  createdAt   DateTime        @default(now())

  // Classement optionnel "par appareil ou projet" (etape 4 du cahier des
  // charges) - au plus un des deux, jamais les deux (verifie cote service).
  deviceId                String?
  device                  CoachingDevice?          @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  materialId              String?
  material                CoachingMaterial?        @relation(fields: [materialId], references: [id], onDelete: SetNull)
  coachingSchemaRevisions CoachingSchemaRevision[]

  @@unique([bucket, path])
  @@index([projectId, createdAt])
  @@index([deviceId])
  @@index([materialId])
}

enum CoachingSessionStatus {
  PREVUE
  REALISEE
  ANNULEE
}

model CoachingSession {
  id              String                @id @default(cuid())
  projectId       String
  project         CoachingProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  durationMinutes Int                   @default(60)
  status          CoachingSessionStatus @default(PREVUE)
  // Note rapide (FICHE_ENTRETIEN_ET_SUIVI_COACHING.md §5) : "WhatsApp /
  // visio / appel / autre" - String libre (pas d'enum ferme), coherent avec
  // le reste du modele : une valeur imprevue ne doit jamais bloquer la saisie.
  channel         String?

  // Compte-rendu (retour utilisateur : "sujets abordes, explications
  // donnees, difficultes et prochaine etape") - jamais un champ qui
  // suggererait une validation de securite/conformite a distance.
  sujetsAbordes       String? @db.Text
  explicationsDonnees String? @db.Text
  difficultes         String? @db.Text
  prochaineEtape      String? @db.Text

  // Visibilite explicite (retour utilisateur : "la synthese partagee doit
  // etre identifiable avant publication") - par defaut privee ; aucun ecran
  // client n'affiche encore CoachingSession aujourd'hui, mais ce marqueur
  // doit exister avant qu'un tel ecran soit construit, pas apres.
  sharedWithClient Boolean @default(false)

  // Reprise DossierAppointment (plan de consolidation, docs/03-DATABASE.md
  // §2) : conserve l'UID ICS existant pour ne jamais dupliquer un
  // abonnement webcal deja installe (app/api/calendar/accompagnements.ics).
  // Nul pour toute seance creee nativement dans le CRM.
  legacyDossierAppointmentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions CoachingActionItem[]

  @@index([projectId])
  @@index([scheduledAt])
  @@index([status])
}

enum CoachingActionStatus {
  A_FAIRE
  FAIT
}

model CoachingActionItem {
  id          String               @id @default(cuid())
  projectId   String
  project     CoachingProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Optionnel : une action peut naitre d'une seance precise, ou etre ajoutee
  // directement sur le projet.
  sessionId   String?
  session     CoachingSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  label       String
  dueDate     DateTime?
  status      CoachingActionStatus @default(A_FAIRE)
  // Qui doit agir — nullable : les actions existantes n'ont pas cette
  // information et ne doivent pas se voir attribuer une valeur inventee.
  responsible CoachingResponsible?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([projectId])
  @@index([status, dueDate])
}

enum CoachingProposalStatus {
  BROUILLON
  ENVOYEE
  ACCEPTEE
  REFUSEE
}

enum CoachingPaymentStatus {
  EN_ATTENTE
  PARTIEL
  PAYE
}

// Suivi commercial manuel (retour utilisateur : "ne pas integrer de nouveau
// prestataire de paiement pour cette premiere version"). Le temps de
// coaching restant ne se stocke jamais ici : il se calcule a la lecture
// (somme des propositions ACCEPTEE moins somme des seances REALISEE du
// projet, voir getCoachingProjectTimeBalance dans
// lib/services/coaching-project.ts) - meme principe deja applique par
// getIncludedAccessForCustomer (lib/services/dossier-client.ts) : ne jamais
// dupliquer un etat derivable, toujours relire la source de verite.
model CoachingProposal {
  id               String                 @id @default(cuid())
  projectId        String
  project          CoachingProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  intitule         String
  montantCents     Int
  montantRecuCents Int                    @default(0)
  dureeMinutes     Int
  status           CoachingProposalStatus @default(BROUILLON)
  paymentStatus    CoachingPaymentStatus  @default(EN_ATTENTE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([projectId])
}

// --- Appareils, scenarios et bilan de consommation (dossier van, phase 1) --
// docs/_local/Prompt_Claude_Fabsystem_Dossier_Van.md, etape 3. Un scenario
// (ete/hiver/...) regroupe des USAGES d'appareils, jamais les appareils
// eux-memes : la meme reference materielle peut avoir un usage different
// par scenario sans etre dupliquee (exigence explicite du cahier des
// charges). Le calcul lui-meme vit dans lib/calc/coaching-consumption.ts
// (module pur, teste sans base de donnees) - ces modeles ne stockent que
// les entrees, jamais un total precalcule.
model CoachingScenario {
  id        String          @id @default(cuid())
  projectId String
  project   CoachingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  usages CoachingDeviceUsage[]

  @@index([projectId])
}

enum CoachingDeviceState {
  ENVISAGE
  CHOISI
  ACHETE
  INSTALLE
}

enum CoachingDevicePhase {
  ACTUEL
  FUTUR
}

enum CoachingDevicePriority {
  INDISPENSABLE
  SOUHAITABLE
  OPTIONNEL
}

enum CoachingPowerSupply {
  DC12
  DC24
  DC_AUTRE
  USB
  AC230
  INCONNU
}

enum CoachingMeasurementPoint {
  APPAREIL
  ENTREE_ADAPTATEUR
  COTE_BATTERIE
}

enum CoachingDataOrigin {
  MESUREE
  DOC_FABRICANT
  ESTIMATION_CLIENT
  ESTIMATION_COACH
}

model CoachingDevice {
  id        String          @id @default(cuid())
  projectId String
  project   CoachingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String
  // Liste de categories suggeree cote UI (eclairage, refrigerateur,
  // ventilation...) mais jamais un enum ferme : le cahier des charges
  // l'exige explicitement ("n'attribue aucune puissance universelle").
  category String
  quantity Int    @default(1)

  brand            String?
  reference        String?
  manufacturerLink String?

  state    CoachingDeviceState    @default(ENVISAGE)
  phase    CoachingDevicePhase    @default(ACTUEL)
  priority CoachingDevicePriority @default(SOUHAITABLE)

  powerSupply      CoachingPowerSupply       @default(INCONNU)
  measurementPoint CoachingMeasurementPoint?
  dataOrigin       CoachingDataOrigin?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages    CoachingDeviceUsage[]
  documents CoachingProjectDocument[]
  circuits  CoachingCircuit[]

  @@index([projectId])
}

enum CoachingCalcMethod {
  PUISSANCE_TEMPS
  ENERGIE_JOUR
  RECHARGE_CYCLE
}

// Une ligne par (appareil, scenario) - voir lib/calc/coaching-consumption.ts
// pour l'implementation exacte des 3 methodes. Tout est nullable : une
// valeur absente signifie "inconnu", jamais 0 (retour utilisateur
// explicite, verifie par les tests de coaching-consumption.test.ts).
model CoachingDeviceUsage {
  id         String           @id @default(cuid())
  deviceId   String
  device     CoachingDevice   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  scenarioId String
  scenario   CoachingScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  calcMethod CoachingCalcMethod

  // Methode 1 - puissance x temps effectif
  continuousPowerW        Float?
  peakPowerW              Float?
  peakDurationMinutes     Float?
  effectiveHoursPerDay    Float?
  // Duree de disponibilite, distincte du temps de fonctionnement reel -
  // dutyCycleRatio ne s'applique QUE si effectiveHoursPerDay est absent,
  // jamais en plus (evite de multiplier deux fois par un taux).
  availabilityHoursPerDay Float?
  dutyCycleRatio          Float?

  // Methode 2 - energie quotidienne connue
  dailyEnergyWhPerUnit    Float?
  // Si vrai, dailyEnergyWhPerUnit est deja un total groupe : ne jamais le
  // multiplier une seconde fois par quantity.
  dailyEnergyIsGroupTotal Boolean @default(false)

  // Methode 3 - recharge / cycle
  energyPerCycleWh Float?
  cyclesPerDay     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, scenarioId])
  @@index([scenarioId])
}

// --- Dossier van, phase 2 (etapes 4-5-6 du cahier des charges) -------------
// docs/_local/Prompt_Claude_Fabsystem_Dossier_Van.md. Meme philosophie que la
// phase 1 : espace partage coach/client pour l'inventaire declaratif
// (materiel possede/choisi, contraintes d'implantation), mais le registre de
// circuits et les revisions de schema restent EXCLUSIVEMENT coach-only (le
// cahier des charges le dit explicitement : "Reserve au coach...").

enum CoachingMaterialCategory {
  BATTERIE
  BMS
  PANNEAU_SOLAIRE
  REGULATEUR
  CHARGEUR_MOTEUR
  CHARGEUR_SECTEUR
  CONVERTISSEUR
  DISTRIBUTION
  PROTECTION
  AUTRE
}

// Materiel du systeme electrique (batterie, BMS, panneaux...) - distinct des
// CoachingDevice (appareils CONSOMMATEURS : frigo, eclairage...). Reutilise
// CoachingDeviceState (Envisage/Choisi/Achete/Installe), meme semantique.
model CoachingMaterial {
  id        String          @id @default(cuid())
  projectId String
  project   CoachingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category     CoachingMaterialCategory
  brand        String?
  reference    String?
  quantity     Int                      @default(1)
  state        CoachingDeviceState      @default(ENVISAGE)
  // Pertinent seulement pour du materiel deja en place (installation
  // existante a modifier) - null sinon, jamais false par defaut (ne pas
  // presumer une decision de conservation non prise).
  keepExisting Boolean?

  // Caracteristiques generiques utiles aux compatibilites (retour
  // utilisateur : "limites de courant, caracteristiques des panneaux,
  // limites des chargeurs") - volontairement generiques plutot qu'un champ
  // par categorie : un meme trio tension/courant/puissance couvre batterie,
  // panneau et chargeur avec un sens legerement different a chaque fois,
  // documente dans characteristicsNotes si besoin de precision.
  ratedVoltage         Float?
  ratedCurrentA        Float?
  ratedPowerW          Float?
  capacityAh           Float? // specifique batterie
  characteristicsNotes String? @db.Text

  // "Dysfonctionnements connus" - pertinent seulement pour du materiel
  // existant, jamais suppose a partir d'un simple etat ENVISAGE/CHOISI.
  knownIssues String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents CoachingProjectDocument[]
  circuits  CoachingCircuit[]

  @@index([projectId])
}

// Registre de circuits (etape 5) - EXCLUSIVEMENT reserve au coach (le
// cahier des charges le dit explicitement). Jamais de deduction silencieuse
// retour <- aller : returnLengthM reste un champ separe, null tant qu'il
// n'est pas explicitement renseigne.
enum CoachingCircuitReviewStatus {
  A_FAIRE
  A_REVOIR
  VALIDE
}

model CoachingCircuit {
  id        String          @id @default(cuid())
  projectId String
  project   CoachingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  label       String // identifiant lisible du circuit (ex. "C1 - Frigo")
  deviceId    String?
  device      CoachingDevice?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  materialId  String?
  material    CoachingMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  source      String?
  destination String?

  systemVoltage      Float?
  calculatedCurrentA Float?

  outboundLengthM      Float?
  outboundLengthOrigin CoachingDataOrigin?
  returnPathPlanned    String?             @db.Text
  returnLengthM        Float?

  // Dimensionnement retenu par le coach :
  electricalLengthM           Float?
  installMethod               String?
  section                     String?
  voltageDropNotes            String?                     @db.Text
  protectionType              String?
  protectionReference         String?
  protectionRatingA           Float?
  protectionRatedVoltage      Float?
  protectionBreakingCapacityA Float?
  protectionLocation          String?
  justification               String?                     @db.Text
  reviewStatus                CoachingCircuitReviewStatus @default(A_FAIRE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([deviceId])
}

enum CoachingSchemaStatus {
  BROUILLON
  A_REVOIR
  REVU_POUR_REALISATION
  MIS_A_JOUR_SELON_INSTALLATION
}

// Instantane fige du dossier+bilan associe a une revision du schema (retour
// utilisateur : "permets de figer un instantane... tout en continuant a
// modifier la version de travail") - snapshotJson n'est JAMAIS recalcule
// apres coup, c'est justement le point d'un instantane.
model CoachingSchemaRevision {
  id             String                   @id @default(cuid())
  projectId      String
  project        CoachingProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisionNumber Int
  documentId     String?
  document       CoachingProjectDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  status         CoachingSchemaStatus     @default(BROUILLON)
  snapshotJson   Json
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([projectId, revisionNumber])
  @@index([projectId])
}

// Historique des modifications importantes avec auteur et date (retour
// utilisateur explicite, etape 6) - meme principe que DossierEvent/
// ProspectEvent : un seul journal plutot que des mecanismes paralleles.
model CoachingProjectEvent {
  id         String          @id @default(cuid())
  projectId  String
  project    CoachingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       String // "VEHICLE_INFO" | "USAGES" | "DEVICE" | "MATERIAL" | "CIRCUIT" | "SCHEMA_REVISION" | "REVIEW"
  authorName String
  note       String?         @db.Text
  createdAt  DateTime        @default(now())

  @@index([projectId, createdAt])
}

// --- Kit (bundles d'achat assignables a un Project) -----------------------
// Corrige a la racine un bug ou /mon-compte/projets/[id]/suivi affichait
// toujours la liste d'achat/budget du kit AFERIY P280 (lib/project-follow-up.ts),
// peu importe le projet reel. Un Kit est cree une fois dans le dashboard puis
// assigne a N projets (Project.kitId) ; buildProjectFollowUpDossier derive
// purchases/budgetLines/photoControls/powerControls/dossierChecklist du kit
// assigne au lieu de constantes fixes.
model Kit {
  id            String   @id @default(cuid())
  name          String
  // Texte libre, pas de ligne budgetaire : listes descriptives simples
  // (titre + pourquoi), contrairement a KitItem qui est achete/priorise.
  photoControls Json?
  powerControls Json?
  checklist     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items    KitItem[]
  projects Project[]
}

model KitItem {
  id          String @id @default(cuid())
  kitId       String
  kit         Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)
  // "Indispensable" | "Option officielle" — memes valeurs que PurchaseItem
  // dans lib/project-follow-up.ts, jamais un enum Prisma (texte affiche
  // directement, pas de mapping de libelle necessaire).
  priority    String
  block       String
  name        String
  why         String @db.Text
  budgetCents Int
  href        String
  sortOrder   Int    @default(0)

  @@index([kitId])
}
