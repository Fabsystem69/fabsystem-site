generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  engineType = "client"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum AssetType {
  VEHICLE
  BOAT
  OTHER
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum ServiceType {
  INTERVENTION
  FORMATION
  AUDIT
  CONSEIL
}

enum DeliveryMode {
  ONSITE
  REMOTE
}

enum RemiseStatus {
  DRAFT
  SENT
  APPLIED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  EBOOK
  DIGITAL_DOWNLOAD
  BUNDLE
}

enum PurchaseMode {
  BUY_NOW
  REQUEST_ONLY
}

enum PriceStatus {
  ACTIVE
  ARCHIVED
}

enum DigitalAssetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DigitalAssetProvider {
  SUPABASE
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum DownloadGrantStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum DiscountCodeStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum DiscountCodeType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum CustomerStatus {
  ACTIVE
  DISABLED
}

// Origine de création du compte (MASTER-04 §3-4, MASTER-10 §11) :
// PURCHASE = premier achat Boutique réel, ADMIN = création manuelle FabSystem.
// Ne pilote aucun droit ; sert uniquement de traçabilité.
enum CustomerOrigin {
  PURCHASE
  ADMIN
}

// Portée d'une capacité : globale au compte, ou scopée à une ressource
// future (ex. Project) référencée par scopeId une fois ce modèle introduit.
enum CapabilityScope {
  CUSTOMER
  PROJECT
}

enum CustomerCapabilityStatus {
  ACTIVE
  REVOKED
}

enum MagicLoginTokenStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum CustomerSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Customer {
  id               String            @id @default(cuid())
  name             String?
  email            String            @unique
  phone            String?
  address          String?
  assetType        AssetType         @default(OTHER)
  assetBrand       String?
  assetModel       String?
  registration     String?
  odometerKm       Int?
  engineHours      Int?
  status           CustomerStatus    @default(ACTIVE)
  origin           CustomerOrigin    @default(PURCHASE)
  lastLoginAt      DateTime?
  quotes           Quote[]
  invoices         Invoice[]
  remises          Remise[]
  orders           Order[]
  magicLoginTokens MagicLoginToken[]
  sessions         CustomerSession[]
  capabilities     CustomerCapability[]
  projects         Project[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([email])
  @@index([status])
  @@index([registration])
  @@index([origin])
}

// Couche 2 (MASTER-11) : droit générique attribué à un Customer, indépendant
// des produits, de Stripe et de Project. `capability` est un identifiant
// fonctionnel libre (non figé par ce MASTER, cf. MASTER-00 §15) ; `scope` /
// `scopeId` permettent de rattacher plus tard une capacité à une ressource
// précise (ex. Project) sans dépendre d'un modèle qui n'existe pas encore.
model CustomerCapability {
  id         String                    @id @default(cuid())
  customerId String
  customer   Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  capability String
  scope      CapabilityScope           @default(CUSTOMER)
  scopeId    String?
  status     CustomerCapabilityStatus  @default(ACTIVE)
  source     String?
  startsAt   DateTime                  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  @@index([customerId])
  @@index([capability])
  @@index([status])
  @@index([customerId, capability])
  @@index([scope, scopeId])
}

// Couche 3 (MASTER-11) : Project, source de vérité métier du travail client
// (MASTER-06 §2, MASTER-10 §41). Objet distinct de Customer, ne dépend
// d'aucun futur module (Volta, Circuits, Schéma, Documents, Accompagnement).

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETE_SCHEDULED
}

// Univers du Project (MASTER-06 §8). Distinct de Customer.assetType : ce
// dernier classe le matériel commercial/quote historique, celui-ci classe
// l'univers du Project SaaS (MASTER-10 §42 : ne pas mélanger profil
// Customer et données techniques du Project).
enum ProjectAssetType {
  BOAT
  VAN
  MOTORHOME
  OTHER
}

// Tension principale (MASTER-06 §8-9) : "Je ne sais pas" est une valeur
// explicite (UNKNOWN), jamais une valeur par défaut inventée à la place du
// client.
enum ProjectVoltage {
  V12
  V24
  UNKNOWN
}

model Project {
  id                String           @id @default(cuid())
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name              String
  assetType         ProjectAssetType
  voltage           ProjectVoltage   @default(UNKNOWN)
  status            ProjectStatus    @default(ACTIVE)
  archivedAt        DateTime?
  // Suppression différée 72h (MASTER-06 §15, MASTER-10 §54-56) : intention
  // et échéance persistées, jamais de timer mémoire. preScheduleStatus
  // conserve l'état à restaurer si le client ou l'Admin annule avant
  // échéance ("restitue le Project dans son état normal", MASTER-10 §56).
  deleteScheduledAt DateTime?
  preScheduleStatus ProjectStatus?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  retainedValues    ProjectRetainedValue[]
  valueDependencies ProjectValueDependency[]
  schema            ProjectSchema?

  @@index([customerId])
  @@index([status])
  @@index([deleteScheduledAt])
}

enum ProjectValueStatus {
  ACTIVE
  OBSOLETE
}

// Socle "valeurs retenues" (MASTER-06 §24-26) : une donnée métier du
// Project peut être calculée (simulatedValue), retenue explicitement
// (value) et marquée obsolète — sans jamais recalculer ni remplacer
// silencieusement le choix du client (MASTER-06 §29, MASTER-10 §48-49).
// `key` est un identifiant fonctionnel libre : aucun calculateur n'est
// développé dans cette phase, donc aucune clé métier n'est figée ici.
model ProjectRetainedValue {
  id             String             @id @default(cuid())
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key            String
  value          Json
  simulatedValue Json?
  status         ProjectValueStatus @default(ACTIVE)
  source         String?
  retainedAt     DateTime           @default(now())
  obsoletedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([projectId, key])
  @@index([projectId])
  @@index([status])
}

// Socle "dépendances" (MASTER-06 §27-30) : déclare qu'une valeur retenue
// dépend d'une autre, pour permettre de cibler ce qui doit être marqué
// obsolète lors d'un changement — sans invalider globalement le Project
// (MASTER-06 §30). Aucune logique métier : uniquement le graphe.
model ProjectValueDependency {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dependentKey String
  dependsOnKey String
  createdAt    DateTime @default(now())

  @@unique([projectId, dependentKey, dependsOnKey])
  @@index([projectId])
  @@index([projectId, dependsOnKey])
}

// Schéma électrique de l'éditeur /outils/schema, lié à un Project (retour
// utilisateur : "il manque enregistrer lié au compte client"). Un seul
// schéma par Project (relation 1:1, contrairement à ProjectRetainedValue
// qui est 1:N par clé) : ce n'est pas une donnée de calcul obsolescible,
// juste le dernier état sauvegardé du dessin — nodes/edges bruts au même
// format que l'enveloppe JSON exportable (features/schemas/jsonIo.ts).
// Suit le Project pour son cycle de vie (onDelete: Cascade), sans état
// d'archivage indépendant.
model ProjectSchema {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectName String
  nodes       Json
  edges       Json
  thumbnail   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quote {
  id                      String       @id @default(cuid())
  number                  String       @unique
  status                  QuoteStatus  @default(DRAFT)
  customerId              String
  customer                Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issueDate               DateTime
  validUntil              DateTime?
  notes                   String?
  subtotal                Int
  tax                     Int
  total                   Int
  serviceType             ServiceType  @default(INTERVENTION)
  deliveryMode            DeliveryMode @default(ONSITE)
  serviceDate             DateTime?
  signedAt                DateTime?
  signedName              String?
  agreementChecked        Boolean      @default(false)
  signatureDataUrl        String?
  signatureTokenHash      String?
  signatureTokenExpiresAt DateTime?
  signatureIp             String?
  signatureUserAgent      String?
  sourceInvoice           Invoice?     @relation("QuoteToInvoice")
  items                   QuoteItem[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([customerId])
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  position    Int

  @@index([quoteId])
}

model Invoice {
  id                String        @id @default(cuid())
  number            String        @unique
  status            InvoiceStatus @default(DRAFT)
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issueDate         DateTime
  dueDate           DateTime?
  currency          String        @default("EUR")
  customerReference String?
  projectReference  String?
  serviceReference  String?
  notes             String?
  subtotal          Int
  tax               Int
  total             Int
  serviceType       ServiceType   @default(INTERVENTION)
  deliveryMode      DeliveryMode  @default(ONSITE)
  serviceDate       DateTime?
  paidAt            DateTime?
  paymentMethod     String?
  paymentRef        String?
  sourceQuoteId     String?       @unique
  sourceQuote       Quote?        @relation("QuoteToInvoice", fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  items             InvoiceItem[]
  remises           Remise[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([customerId])
  @@index([paidAt])
  @@index([sourceQuoteId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  position    Int

  @@index([invoiceId])
}

model Remise {
  id         String       @id @default(cuid())
  number     String       @unique
  status     RemiseStatus @default(DRAFT)
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId  String?
  invoice    Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount     Int
  reason     String?
  date       DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([customerId])
  @@index([invoiceId])
}

model ItemTemplate {
  id                    String   @id @default(cuid())
  label                 String   @unique
  unit                  String?
  defaultUnitPriceCents Int?
  lastUsedAt            DateTime @default(now())
  useCount              Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model DocumentSequence {
  key          String   @id
  prefix       String
  year         Int
  currentValue Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([prefix, year])
}

model Product {
  id                String          @id @default(cuid())
  slug              String          @unique
  name              String
  shortDescription  String?
  description       String?
  status            ProductStatus   @default(DRAFT)
  productType       ProductType
  purchaseMode      PurchaseMode    @default(BUY_NOW)
  featuredImage     String?
  prices            ProductPrice[]
  assets            ProductAsset[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  downloadGrants    DownloadGrant[]
  discountCodes     DiscountCode[]
  discountRedemptions DiscountRedemption[]
  bundleItems       BundleItem[]    @relation("BundleProductItems")
  includedInBundles BundleItem[]    @relation("IncludedProductItems")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
  @@index([productType])
  @@index([purchaseMode])
}

model ProductPrice {
  id                   String      @id @default(cuid())
  productId            String
  product              Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  currency             String      @default("EUR")
  unitAmountCents      Int
  compareAtAmountCents Int?
  status               PriceStatus @default(ACTIVE)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([productId])
  @@index([status])
}

model DigitalAsset {
  id             String               @id @default(cuid())
  provider       DigitalAssetProvider @default(SUPABASE)
  bucket         String
  path           String
  filename       String
  contentType    String
  sizeBytes      Int
  version        String?
  status         DigitalAssetStatus   @default(DRAFT)
  products       ProductAsset[]
  downloadGrants DownloadGrant[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([bucket, path])
  @@index([status])
  @@index([provider])
}

model ProductAsset {
  productId String
  assetId   String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset     DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@id([productId, assetId])
  @@index([assetId])
}

model BundleItem {
  bundleProductId   String
  includedProductId String
  bundleProduct     Product  @relation("BundleProductItems", fields: [bundleProductId], references: [id], onDelete: Cascade)
  includedProduct   Product  @relation("IncludedProductItems", fields: [includedProductId], references: [id], onDelete: Restrict)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  @@id([bundleProductId, includedProductId])
  @@index([includedProductId])
}

model Cart {
  id            String     @id @default(cuid())
  status        CartStatus @default(ACTIVE)
  sessionId     String?    @unique
  customerEmail String?
  items         CartItem[]
  order         Order?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([customerEmail])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id             String          @id @default(cuid())
  orderNumber    String          @unique
  status         OrderStatus     @default(DRAFT)
  customerId     String?
  discountCodeId String?
  customerEmail  String
  customerName   String?
  currency       String          @default("EUR")
  subtotalCents  Int
  discountTotalCents Int         @default(0)
  totalCents     Int
  cartId         String?         @unique
  cart           Cart?           @relation(fields: [cartId], references: [id], onDelete: SetNull)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountCode   DiscountCode?   @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payments       Payment[]
  downloadGrants DownloadGrant[]
  discountRedemptions DiscountRedemption[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  paidAt         DateTime?
  cancelledAt    DateTime?
  refundedAt     DateTime?

  @@index([status])
  @@index([customerId])
  @@index([customerEmail])
  @@index([discountCodeId])
  @@index([createdAt])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  productId       String
  productSlug     String
  productName     String
  productType     ProductType
  quantity        Int             @default(1)
  currency        String          @default("EUR")
  unitAmountCents Int
  lineTotalCents  Int
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  downloadGrants  DownloadGrant[]
  createdAt       DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                      String          @id @default(cuid())
  orderId                 String
  provider                PaymentProvider @default(STRIPE)
  status                  PaymentStatus   @default(PENDING)
  amountCents             Int
  currency                String          @default("EUR")
  stripeCheckoutSessionId String?         @unique
  stripePaymentIntentId   String?
  stripeCustomerId        String?
  rawProviderStatus       String?
  order                   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  succeededAt             DateTime?
  failedAt                DateTime?
  refundedAt              DateTime?

  @@index([orderId])
  @@index([status])
  @@index([provider])
  @@index([stripePaymentIntentId])
}

model DownloadGrant {
  id               String              @id @default(cuid())
  orderId          String
  orderItemId      String
  productId        String
  assetId          String
  customerEmail    String
  status           DownloadGrantStatus @default(ACTIVE)
  downloadCount    Int                 @default(0)
  maxDownloads     Int                 @default(10)
  expiresAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  revokedAt        DateTime?
  lastDownloadedAt DateTime?
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem        OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  asset            DigitalAsset        @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, assetId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([assetId])
  @@index([customerEmail])
  @@index([status])
  @@index([expiresAt])
}

model DiscountCode {
  id              String               @id @default(cuid())
  code            String               @unique
  status          DiscountCodeStatus   @default(ACTIVE)
  type            DiscountCodeType
  amountOffCents  Int?
  percentOff      Int?
  currency        String               @default("EUR")
  maxRedemptions  Int                  @default(1)
  redeemedCount   Int                  @default(0)
  startsAt        DateTime?
  expiresAt       DateTime?
  productId       String?
  customerEmail   String?
  reason          String?
  product         Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  orders          Order[]
  redemptions     DiscountRedemption[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status])
  @@index([productId])
  @@index([customerEmail])
  @@index([expiresAt])
}

model DiscountRedemption {
  id                    String       @id @default(cuid())
  discountCodeId        String
  orderId               String
  customerEmail         String
  productId             String?
  amountDiscountedCents Int
  redeemedAt            DateTime     @default(now())
  discountCode          DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Restrict)
  order                 Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product               Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([discountCodeId, orderId])
  @@index([discountCodeId])
  @@index([orderId])
  @@index([customerEmail])
  @@index([productId])
}

model MagicLoginToken {
  id         String                @id @default(cuid())
  customerId String
  email      String
  tokenHash  String                @unique
  status     MagicLoginTokenStatus @default(ACTIVE)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime              @default(now())
  customer   Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model CustomerSession {
  id               String                @id @default(cuid())
  customerId       String
  sessionTokenHash String                @unique
  status           CustomerSessionStatus @default(ACTIVE)
  expiresAt        DateTime
  createdAt        DateTime              @default(now())
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  customer         Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
}

enum TestimonialCustomerType {
  VAN
  CAMPING_CAR
  BOAT
  OTHER
}

model Testimonial {
  id                 String                  @id @default(cuid())
  displayName        String
  customerType       TestimonialCustomerType @default(OTHER)
  vehicleModel       String?
  region             String?
  rating             Int
  quote              String
  relatedOffer       String?
  isVerifiedPurchase Boolean                 @default(false)
  isPublished        Boolean                 @default(false)
  isFeatured         Boolean                 @default(false)
  displayOrder       Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([isPublished])
  @@index([isFeatured])
  @@index([displayOrder])
}
