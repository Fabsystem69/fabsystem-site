generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  engineType = "client"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // La connexion effective des migrations est fournie par prisma.config.ts
  // (DIRECT_URL localement, DATABASE_URL_UNPOOLED sur Vercel). Cette valeur
  // garde le schéma portable pour la validation Prisma.
  directUrl         = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum AssetType {
  VEHICLE
  BOAT
  OTHER
}

// v2.1 : renseigne par le client dans sa fiche profil — permet de cibler le
// mailing par niveau (ex. contenus debutant vs guides avances).
enum ElectricalSkillLevel {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum ServiceType {
  INTERVENTION
  FORMATION
  AUDIT
  CONSEIL
}

enum DeliveryMode {
  ONSITE
  REMOTE
}

enum RemiseStatus {
  DRAFT
  SENT
  APPLIED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  EBOOK
  DIGITAL_DOWNLOAD
  BUNDLE
  // v2.1 : deverrouillage payant d'un Project (editeur de schema), lie a un
  // Order via Order.projectId plutot qu'a un ProductAsset — ne doit jamais
  // declencher la generation de DownloadGrant (createDownloadGrantsForOrder
  // se base sur les assets du Product, absents ici, donc aucun cas special
  // requis).
  SCHEMA_UNLOCK
  // v2.1 : créneau de conseil ponctuel (30 min, visio ou téléphone),
  // proposé dans l'éditeur de schéma quand l'utilisateur semble bloqué
  // (voir CoachingOfferWidget.tsx) — pas de DownloadGrant ni de capability
  // à octroyer, juste une commande normale : sendPurchaseNotification
  // (déjà appelée pour toute commande payée) suffit à alerter Fabien pour
  // qu'il recontacte le client et cale le rendez-vous.
  COACHING_30MIN
}

enum PurchaseMode {
  BUY_NOW
  REQUEST_ONLY
}

enum PriceStatus {
  ACTIVE
  ARCHIVED
}

enum DigitalAssetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DigitalAssetProvider {
  SUPABASE
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum DownloadGrantStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum DiscountCodeStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum DiscountCodeType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum CustomerStatus {
  ACTIVE
  DISABLED
}

// Origine de création du compte (MASTER-04 §3-4, MASTER-10 §11) :
// PURCHASE = premier achat Boutique réel, ADMIN = création manuelle FabSystem.
// Ne pilote aucun droit ; sert uniquement de traçabilité.
enum CustomerOrigin {
  PURCHASE
  ADMIN
  // v2.1 : inscription libre (email + mot de passe choisi), proposée dans
  // l'éditeur de schéma dès l'ouverture — voir SignupPromptWidget.tsx et
  // lib/services/customer-signup.ts. Choix produit assumé, différent de la
  // décision anti-énumération sur le formulaire de connexion (MASTER-00
  // §6) : ici l'utilisateur affirme explicitement vouloir créer un compte,
  // ce n'est jamais une conséquence silencieuse d'une simple tentative de
  // connexion.
  SIGNUP
}

// Portée d'une capacité : globale au compte, ou scopée à une ressource
// future (ex. Project) référencée par scopeId une fois ce modèle introduit.
enum CapabilityScope {
  CUSTOMER
  PROJECT
}

enum CustomerCapabilityStatus {
  ACTIVE
  REVOKED
}

enum MagicLoginTokenStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum CustomerSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Customer {
  id                         String                      @id @default(cuid())
  // `name` reste la source lue par tout le code existant (commandes, emails,
  // dashboard admin) — jamais retire pour ne pas casser ces usages. Les
  // nouveaux champs firstName/lastName sont la vraie fiche client editable
  // par le client lui-meme (lib/services/customer-profile.ts) ; chaque
  // mise a jour y resynchronise `name` = "firstName lastName".
  name                       String?
  firstName                  String?
  lastName                   String?
  email                      String                      @unique
  // v2.1 : bascule email+mot de passe (retour utilisateur : le lien magique
  // seul n'est pas assez conventionnel). Nullable — les comptes existants
  // n'en ont pas tant qu'ils ne l'ont pas defini via le lien magique reconverti
  // en flux "definir mon mot de passe" (voir app/api/client-auth/verify).
  passwordHash               String?
  phone                      String?
  address                    String?
  electricalSkillLevel       ElectricalSkillLevel?
  assetType                  AssetType                   @default(OTHER)
  assetBrand                 String?
  assetModel                 String?
  registration               String?
  odometerKm                 Int?
  engineHours                Int?
  status                     CustomerStatus              @default(ACTIVE)
  origin                     CustomerOrigin              @default(PURCHASE)
  // RGPD : consentement explicite et horodaté, jamais présumé — la case à
  // cocher (voir InlineSignupForm.tsx) part toujours décochée, cocher est
  // un geste actif de l'utilisateur. `marketingConsentAt` sert de preuve de
  // consentement (date + le fait qu'il ait été donné, pas juste un booléen
  // muet) et se réinitialise à `null` si jamais retiré plus tard.
  marketingConsent           Boolean                     @default(false)
  marketingConsentAt         DateTime?
  // Consentement distinct du marketing : autorise l'admin à consulter le
  // dossier projet du client depuis le dashboard (retour utilisateur —
  // accès au "dossier" pour accompagner un client sans re-demander ses
  // infos à chaque échange). Même logique de preuve horodatée que
  // marketingConsent ci-dessus.
  dataShareConsent           Boolean                     @default(false)
  dataShareConsentAt         DateTime?
  // Lien vers un espace de partage externe (Google Drive, Dropbox...) où le
  // client dépose ses schémas/calculs — retour utilisateur : simple champ
  // lien, pas de stockage de fichiers à construire côté FabSystem. Visible
  // par l'admin sur la fiche client, éditable par le client sur son profil.
  driveLinkUrl               String?
  lastLoginAt                DateTime?
  quotes                     Quote[]
  invoices                   Invoice[]
  remises                    Remise[]
  orders                     Order[]
  magicLoginTokens           MagicLoginToken[]
  sessions                   CustomerSession[]
  capabilities               CustomerCapability[]
  projects                   Project[]
  trialAccessCodeRedemptions TrialAccessCodeRedemption[]
  customCatalogItems         CustomCatalogItem[]
  errorReports               ErrorReport[]
  resourceGrants             CustomerResourceGrant[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@index([email])
  @@index([status])
  @@index([registration])
  @@index([origin])
}

// Retour utilisateur : "possible d'avoir les remontées d'erreur avec l'id
// du client quand cela se passe directement dans mon dashboard ?" — jusqu'ici
// les erreurs serveur (5xx) ne partaient que dans les logs Vercel, sans
// aucun lien vers le compte concerné (voir l'audit rate-limit du 19/08, où
// il a fallu recouper IP + heure + requête SQL manuelle pour identifier le
// client). `customerId` nullable : une erreur peut survenir hors contexte
// authentifié (visiteur anonyme, échec avant résolution de session) — on ne
// perd pas l'erreur pour autant, juste le lien client.
model ErrorReport {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  route      String
  message    String
  statusCode Int
  code       String?
  details    Json?
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@index([createdAt])
}

// Couche 2 (MASTER-11) : droit générique attribué à un Customer, indépendant
// des produits, de Stripe et de Project. `capability` est un identifiant
// fonctionnel libre (non figé par ce MASTER, cf. MASTER-00 §15) ; `scope` /
// `scopeId` permettent de rattacher plus tard une capacité à une ressource
// précise (ex. Project) sans dépendre d'un modèle qui n'existe pas encore.
model CustomerCapability {
  id         String                   @id @default(cuid())
  customerId String
  customer   Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  capability String
  scope      CapabilityScope          @default(CUSTOMER)
  scopeId    String?
  status     CustomerCapabilityStatus @default(ACTIVE)
  source     String?
  startsAt   DateTime                 @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@index([customerId])
  @@index([capability])
  @@index([status])
  @@index([customerId, capability])
  @@index([scope, scopeId])
}

// Item de catalogue créé par un utilisateur dans l'éditeur de schémas
// (retour utilisateur : "widget qui fait la création d'item personnalisé si
// manquant") — même forme qu'un `BrandModel` du code (lib/electrical-
// components/brand-models.ts), mais privé au compte qui l'a créé, jamais
// mélangé automatiquement au catalogue officiel partagé. `componentType`
// choisi par l'utilisateur détermine les champs possibles (`defaults`),
// exactement comme pour un modèle de marque officiel. Photo stockée en
// base64 directement (même approche que `Quote.signatureDataUrl`, voir
// lib/signature-image.ts) plutôt qu'un service de stockage externe — la
// limite de poids (250 Ko, voir lib/custom-catalog-image.ts) rend ce choix
// raisonnable, pas besoin de la complexité d'un bucket pour ce volume.
model CustomCatalogItem {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  componentType String
  brand         String
  model         String
  defaults      Json
  imageDataUrl  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
  @@index([componentType])
}

// Couche 3 (MASTER-11) : Project, source de vérité métier du travail client
// (MASTER-06 §2, MASTER-10 §41). Objet distinct de Customer, ne dépend
// d'aucun futur module (Volta, Circuits, Schéma, Documents, Accompagnement).

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETE_SCHEDULED
}

// Univers du Project (MASTER-06 §8). Distinct de Customer.assetType : ce
// dernier classe le matériel commercial/quote historique, celui-ci classe
// l'univers du Project SaaS (MASTER-10 §42 : ne pas mélanger profil
// Customer et données techniques du Project).
enum ProjectAssetType {
  BOAT
  VAN
  MOTORHOME
  OTHER
}

// Tension principale (MASTER-06 §8-9) : "Je ne sais pas" est une valeur
// explicite (UNKNOWN), jamais une valeur par défaut inventée à la place du
// client.
enum ProjectVoltage {
  V12
  V24
  UNKNOWN
}

model Project {
  id                String           @id @default(cuid())
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name              String
  assetType         ProjectAssetType
  voltage           ProjectVoltage   @default(UNKNOWN)
  status            ProjectStatus    @default(ACTIVE)
  archivedAt        DateTime?
  // Suppression différée 72h (MASTER-06 §15, MASTER-10 §54-56) : intention
  // et échéance persistées, jamais de timer mémoire. preScheduleStatus
  // conserve l'état à restaurer si le client ou l'Admin annule avant
  // échéance ("restitue le Project dans son état normal", MASTER-10 §56).
  deleteScheduledAt DateTime?
  preScheduleStatus ProjectStatus?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  retainedValues    ProjectRetainedValue[]
  valueDependencies ProjectValueDependency[]
  schema            ProjectSchema?
  followUpReviews   ProjectFollowUpReview[]
  followUpEvents    ProjectFollowUpEvent[]
  // v2.1 : commandes de deverrouillage (SCHEMA_UNLOCK) liees a ce Project.
  // Optionnel cote Order (un Order "normal" n'a pas de Project) — voir
  // Order.projectId.
  orders            Order[]

  @@index([customerId])
  @@index([status])
  @@index([deleteScheduledAt])
}

enum ProjectFollowUpReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum ProjectFollowUpEventType {
  NOTE
  APPROVED
  CHANGES_REQUESTED
}

// Couche humaine du suivi : le statut technique continue d'etre deduit des
// donnees du projet; cette table indique uniquement la decision FabSystem sur
// une etape et la consigne a afficher au client.
model ProjectFollowUpReview {
  id         String                      @id @default(cuid())
  projectId  String
  project    Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepKey    String
  status     ProjectFollowUpReviewStatus @default(PENDING)
  adminNote  String?                     @db.Text
  reviewedAt DateTime?
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  @@unique([projectId, stepKey])
  @@index([projectId, status])
}

// Journal append-only des validations et demandes de correction, afin que le
// client et l'admin puissent retrouver qui a demande quoi et quand.
model ProjectFollowUpEvent {
  id         String                       @id @default(cuid())
  projectId  String
  project    Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepKey    String
  type       ProjectFollowUpEventType
  message    String?                      @db.Text
  authorName String                       @default("FabSystem")
  createdAt  DateTime                     @default(now())

  @@index([projectId, createdAt])
}

enum ProjectValueStatus {
  ACTIVE
  OBSOLETE
}

// Socle "valeurs retenues" (MASTER-06 §24-26) : une donnée métier du
// Project peut être calculée (simulatedValue), retenue explicitement
// (value) et marquée obsolète — sans jamais recalculer ni remplacer
// silencieusement le choix du client (MASTER-06 §29, MASTER-10 §48-49).
// `key` est un identifiant fonctionnel libre : aucun calculateur n'est
// développé dans cette phase, donc aucune clé métier n'est figée ici.
model ProjectRetainedValue {
  id             String             @id @default(cuid())
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key            String
  value          Json
  simulatedValue Json?
  status         ProjectValueStatus @default(ACTIVE)
  source         String?
  retainedAt     DateTime           @default(now())
  obsoletedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([projectId, key])
  @@index([projectId])
  @@index([status])
}

// Socle "dépendances" (MASTER-06 §27-30) : déclare qu'une valeur retenue
// dépend d'une autre, pour permettre de cibler ce qui doit être marqué
// obsolète lors d'un changement — sans invalider globalement le Project
// (MASTER-06 §30). Aucune logique métier : uniquement le graphe.
model ProjectValueDependency {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dependentKey String
  dependsOnKey String
  createdAt    DateTime @default(now())

  @@unique([projectId, dependentKey, dependsOnKey])
  @@index([projectId])
  @@index([projectId, dependsOnKey])
}

// Schéma électrique de l'éditeur /outils/schema, lié à un Project (retour
// utilisateur : "il manque enregistrer lié au compte client"). Un seul
// schéma par Project (relation 1:1, contrairement à ProjectRetainedValue
// qui est 1:N par clé) : ce n'est pas une donnée de calcul obsolescible,
// juste le dernier état sauvegardé du dessin — nodes/edges bruts au même
// format que l'enveloppe JSON exportable (features/schemas/jsonIo.ts).
// Suit le Project pour son cycle de vie (onDelete: Cascade), sans état
// d'archivage indépendant.
model ProjectSchema {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectName String
  nodes       Json
  edges       Json
  thumbnail   String?  @db.Text
  // Jeton public opaque, distinct de l'id projet : seul ce secret permet la
  // lecture du schema partage, jamais l'ecriture ni l'acces au projet.
  shareToken  String?  @unique
  shareEnabledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions    ProjectSchemaVersion[]
}

enum ProjectSchemaVersionAuthor {
  ADMIN
  CUSTOMER
}

// Snapshot volontairement immuable d'une étape importante du schéma. Le
// brouillon actif reste dans ProjectSchema ; cette table n'est alimentée que
// par une action explicite ou lors d'un envoi vers un projet client.
model ProjectSchemaVersion {
  id             String                     @id @default(cuid())
  projectSchemaId String
  projectSchema  ProjectSchema              @relation(fields: [projectSchemaId], references: [id], onDelete: Cascade)
  versionNumber  Int
  authorType     ProjectSchemaVersionAuthor
  authorName     String
  label          String?
  projectName    String
  nodes          Json
  edges          Json
  thumbnail      String?                    @db.Text
  createdAt      DateTime                   @default(now())

  @@unique([projectSchemaId, versionNumber])
  @@index([projectSchemaId, createdAt])
}

// Espace de travail privé du dashboard : aucun faux Customer ou Project n'est
// créé lorsqu'un administrateur prépare un schéma avant de l'envoyer à un
// accompagnement client.
model AdminSchemaDraft {
  id          String   @id @default(cuid())
  name        String
  nodes       Json
  edges       Json
  thumbnail   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

model Quote {
  id                      String       @id @default(cuid())
  number                  String       @unique
  status                  QuoteStatus  @default(DRAFT)
  customerId              String
  customer                Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issueDate               DateTime
  validUntil              DateTime?
  notes                   String?
  subtotal                Int
  tax                     Int
  total                   Int
  serviceType             ServiceType  @default(INTERVENTION)
  deliveryMode            DeliveryMode @default(ONSITE)
  serviceDate             DateTime?
  signedAt                DateTime?
  signedName              String?
  agreementChecked        Boolean      @default(false)
  signatureDataUrl        String?
  signatureTokenHash      String?
  signatureTokenExpiresAt DateTime?
  signatureIp             String?
  signatureUserAgent      String?
  sourceInvoice           Invoice?     @relation("QuoteToInvoice")
  items                   QuoteItem[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([customerId])
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  position    Int

  @@index([quoteId])
}

model Invoice {
  id                String        @id @default(cuid())
  number            String        @unique
  status            InvoiceStatus @default(DRAFT)
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issueDate         DateTime
  dueDate           DateTime?
  currency          String        @default("EUR")
  customerReference String?
  projectReference  String?
  serviceReference  String?
  notes             String?
  subtotal          Int
  tax               Int
  total             Int
  serviceType       ServiceType   @default(INTERVENTION)
  deliveryMode      DeliveryMode  @default(ONSITE)
  serviceDate       DateTime?
  paidAt            DateTime?
  paymentMethod     String?
  paymentRef        String?
  sourceQuoteId     String?       @unique
  sourceQuote       Quote?        @relation("QuoteToInvoice", fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  items             InvoiceItem[]
  remises           Remise[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([customerId])
  @@index([paidAt])
  @@index([sourceQuoteId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  position    Int

  @@index([invoiceId])
}

model Remise {
  id         String       @id @default(cuid())
  number     String       @unique
  status     RemiseStatus @default(DRAFT)
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId  String?
  invoice    Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount     Int
  reason     String?
  date       DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([customerId])
  @@index([invoiceId])
}

model ItemTemplate {
  id                    String   @id @default(cuid())
  label                 String   @unique
  unit                  String?
  defaultUnitPriceCents Int?
  lastUsedAt            DateTime @default(now())
  useCount              Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model DocumentSequence {
  key          String   @id
  prefix       String
  year         Int
  currentValue Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([prefix, year])
}

model Product {
  id                  String                  @id @default(cuid())
  slug                String                  @unique
  name                String
  shortDescription    String?
  description         String?
  status              ProductStatus           @default(DRAFT)
  productType         ProductType
  purchaseMode        PurchaseMode            @default(BUY_NOW)
  featuredImage       String?
  prices              ProductPrice[]
  assets              ProductAsset[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  downloadGrants      DownloadGrant[]
  resourceGrants      CustomerResourceGrant[]
  discountCodes       DiscountCode[]
  discountRedemptions DiscountRedemption[]
  bundleItems         BundleItem[]            @relation("BundleProductItems")
  includedInBundles   BundleItem[]            @relation("IncludedProductItems")
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([status])
  @@index([productType])
  @@index([purchaseMode])
}

model ProductPrice {
  id                   String      @id @default(cuid())
  productId            String
  product              Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  currency             String      @default("EUR")
  unitAmountCents      Int
  compareAtAmountCents Int?
  status               PriceStatus @default(ACTIVE)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([productId])
  @@index([status])
}

model DigitalAsset {
  id             String                  @id @default(cuid())
  provider       DigitalAssetProvider    @default(SUPABASE)
  bucket         String
  path           String
  filename       String
  contentType    String
  sizeBytes      Int
  version        String?
  status         DigitalAssetStatus      @default(DRAFT)
  products       ProductAsset[]
  downloadGrants DownloadGrant[]
  resourceGrants CustomerResourceGrant[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([bucket, path])
  @@index([status])
  @@index([provider])
}

model ProductAsset {
  productId String
  assetId   String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset     DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@id([productId, assetId])
  @@index([assetId])
}

model BundleItem {
  bundleProductId   String
  includedProductId String
  bundleProduct     Product  @relation("BundleProductItems", fields: [bundleProductId], references: [id], onDelete: Cascade)
  includedProduct   Product  @relation("IncludedProductItems", fields: [includedProductId], references: [id], onDelete: Restrict)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  @@id([bundleProductId, includedProductId])
  @@index([includedProductId])
}

model Cart {
  id            String     @id @default(cuid())
  status        CartStatus @default(ACTIVE)
  sessionId     String?    @unique
  customerEmail String?
  items         CartItem[]
  order         Order?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([customerEmail])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique
  status              OrderStatus          @default(DRAFT)
  customerId          String?
  discountCodeId      String?
  customerEmail       String
  customerName        String?
  currency            String               @default("EUR")
  subtotalCents       Int
  discountTotalCents  Int                  @default(0)
  totalCents          Int
  cartId              String?              @unique
  // v2.1 : renseigne uniquement pour un Order dont l'item est un produit
  // SCHEMA_UNLOCK — permet au webhook Stripe de savoir quel Project
  // deverrouiller a la confirmation du paiement (les metadata Stripe ne sont
  // jamais persistees, voir stripe-webhook-commerce.ts).
  projectId           String?
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cart                Cart?                @relation(fields: [cartId], references: [id], onDelete: SetNull)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountCode        DiscountCode?        @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]
  downloadGrants      DownloadGrant[]
  discountRedemptions DiscountRedemption[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  paidAt              DateTime?
  cancelledAt         DateTime?
  refundedAt          DateTime?

  @@index([status])
  @@index([customerId])
  @@index([customerEmail])
  @@index([discountCodeId])
  @@index([projectId])
  @@index([createdAt])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  productId       String
  productSlug     String
  productName     String
  productType     ProductType
  quantity        Int             @default(1)
  currency        String          @default("EUR")
  unitAmountCents Int
  lineTotalCents  Int
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  downloadGrants  DownloadGrant[]
  createdAt       DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                      String          @id @default(cuid())
  orderId                 String
  provider                PaymentProvider @default(STRIPE)
  status                  PaymentStatus   @default(PENDING)
  amountCents             Int
  currency                String          @default("EUR")
  stripeCheckoutSessionId String?         @unique
  stripePaymentIntentId   String?
  stripeCustomerId        String?
  rawProviderStatus       String?
  order                   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  succeededAt             DateTime?
  failedAt                DateTime?
  refundedAt              DateTime?

  @@index([orderId])
  @@index([status])
  @@index([provider])
  @@index([stripePaymentIntentId])
}

model DownloadGrant {
  id               String              @id @default(cuid())
  orderId          String
  orderItemId      String
  productId        String
  assetId          String
  customerEmail    String
  status           DownloadGrantStatus @default(ACTIVE)
  downloadCount    Int                 @default(0)
  maxDownloads     Int                 @default(10)
  expiresAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  revokedAt        DateTime?
  lastDownloadedAt DateTime?
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem        OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  asset            DigitalAsset        @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, assetId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([assetId])
  @@index([customerEmail])
  @@index([status])
  @@index([expiresAt])
}

// Octroi manuel d'une ressource numérique par l'admin (ex. ebook offert
// pour un SAV) — délibérément indépendant d'Order/OrderItem (contrairement
// à DownloadGrant ci-dessus) car il n'y a pas de commande réelle : les FK
// pointent directement sur Customer, sans transiter par un Order fictif à
// 0€ qui polluerait les stats de commandes.
model CustomerResourceGrant {
  id               String              @id @default(cuid())
  customerId       String
  productId        String
  assetId          String
  note             String?
  status           DownloadGrantStatus @default(ACTIVE)
  downloadCount    Int                 @default(0)
  maxDownloads     Int                 @default(10)
  expiresAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  revokedAt        DateTime?
  lastDownloadedAt DateTime?
  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  asset            DigitalAsset        @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([productId])
  @@index([assetId])
  @@index([status])
  @@index([expiresAt])
}

model DiscountCode {
  id             String               @id @default(cuid())
  code           String               @unique
  status         DiscountCodeStatus   @default(ACTIVE)
  type           DiscountCodeType
  amountOffCents Int?
  percentOff     Int?
  currency       String               @default("EUR")
  maxRedemptions Int                  @default(1)
  redeemedCount  Int                  @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  productId      String?
  customerEmail  String?
  reason         String?
  product        Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  orders         Order[]
  redemptions    DiscountRedemption[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status])
  @@index([productId])
  @@index([customerEmail])
  @@index([expiresAt])
}

model DiscountRedemption {
  id                    String       @id @default(cuid())
  discountCodeId        String
  orderId               String
  customerEmail         String
  productId             String?
  amountDiscountedCents Int
  redeemedAt            DateTime     @default(now())
  discountCode          DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Restrict)
  order                 Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product               Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([discountCodeId, orderId])
  @@index([discountCodeId])
  @@index([orderId])
  @@index([customerEmail])
  @@index([productId])
}

model MagicLoginToken {
  id         String                @id @default(cuid())
  customerId String
  email      String
  tokenHash  String                @unique
  status     MagicLoginTokenStatus @default(ACTIVE)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime              @default(now())
  customer   Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model CustomerSession {
  id               String                @id @default(cuid())
  customerId       String
  sessionTokenHash String                @unique
  status           CustomerSessionStatus @default(ACTIVE)
  expiresAt        DateTime
  createdAt        DateTime              @default(now())
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  customer         Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
}

enum TestimonialCustomerType {
  VAN
  CAMPING_CAR
  BOAT
  OTHER
}

model Testimonial {
  id                 String                  @id @default(cuid())
  displayName        String
  customerType       TestimonialCustomerType @default(OTHER)
  vehicleModel       String?
  region             String?
  rating             Int
  quote              String
  relatedOffer       String?
  isVerifiedPurchase Boolean                 @default(false)
  isPublished        Boolean                 @default(false)
  isFeatured         Boolean                 @default(false)
  displayOrder       Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([isPublished])
  @@index([isFeatured])
  @@index([displayOrder])
}

enum TrialAccessCodeStatus {
  ACTIVE
  REVOKED
}

// v2.1 : code promo distribue (communaute, groupes) donnant un acces
// illimite temporaire a l'editeur de schema, sans paiement — distinct de
// DiscountCode qui reduit un prix a l'achat. Un code cree une
// CustomerCapability (scope=CUSTOMER, expiresAt=maintenant+durationDays) sur
// tous les projets du compte qui le saisit, jamais l'inverse.
model TrialAccessCode {
  id             String                      @id @default(cuid())
  code           String                      @unique
  capability     String
  durationDays   Int                         @default(7)
  status         TrialAccessCodeStatus       @default(ACTIVE)
  maxRedemptions Int                         @default(1)
  redeemedCount  Int                         @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  reason         String?
  // Les codes issus d'un achat restent lies a leur commande : cela rend la
  // creation idempotente lors d'une relivraison Stripe, sans modifier les
  // codes communautaires existants (sourceOrderId reste nullable).
  sourceOrderId  String?                     @unique
  // Un code commercial ne peut etre active que depuis le compte de l'adresse
  // ayant passe la commande. Les anciens codes restent non nominatifs.
  recipientEmail String?
  redemptions    TrialAccessCodeRedemption[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([status])
}

// Un compte ne peut consommer un meme code qu'une fois (@@unique) — un
// visiteur qui recree un compte avec un autre email peut en theorie
// reutiliser le meme code : accepte pour un code promo communautaire (pas de
// verification d'identite), a surveiller cote volumetrie si abus.
model TrialAccessCodeRedemption {
  id         String          @id @default(cuid())
  codeId     String
  code       TrialAccessCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  redeemedAt DateTime        @default(now())

  @@unique([codeId, customerId])
  @@index([customerId])
}
