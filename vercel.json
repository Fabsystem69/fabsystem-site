{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npx prisma migrate deploy && npm run build",
  "crons": [
    {
      "path": "/api/internal/jobs/purge-scheduled-deletions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/jobs/schema-unlock-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/internal/jobs/editor-crm-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/internal/jobs/dossier-notifications",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/internal/jobs/purge-pending-orders",
      "schedule": "0 4 * * *"
    }
  ]
}
