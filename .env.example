# ============================================================================
# FabSystem environment example
# Copy this file to `.env.local` or your target environment and replace values.
# Never commit real secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
# NODE_ENV is used in code but is normally managed by Next.js / Vercel.
# Do not hardcode it here unless you have a specific local debugging need.

# ----------------------------------------------------------------------------
# Admin authentication
# ----------------------------------------------------------------------------
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD_HASH='$2b$10$replace_with_bcrypt_hash'
AUTH_SESSION_SECRET=replace_with_a_long_random_secret
AUTH_COOKIE_NAME=fabsystem_session

# Temporary legacy compatibility for WebAuthn admin flows.
# Keep this aligned with AUTH_ADMIN_EMAIL until the code is unified.
ADMIN_EMAIL=admin@example.com

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Safe local Prisma development example:
# - never use `template1`
# - never use production for `prisma migrate dev`
# - use a dedicated dev database and a dedicated shadow database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fabsystem_dev"
# Used by Prisma config / migrations. Keep it aligned with DATABASE_URL unless
# you intentionally use a separate direct connection string.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fabsystem_dev"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fabsystem_shadow"

# ----------------------------------------------------------------------------
# SMTP / transactional email
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for implicit TLS, false for STARTTLS/plain upgrade depending on provider
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=replace_with_smtp_password

# Contact and outbound sender settings
# CONTACT_TO: recipient for public contact messages
# CONTACT_FROM: sender used for contact and some internal outbound emails
CONTACT_TO=contact@example.com
CONTACT_FROM=no-reply@example.com

# Not read by any route since the Sprint 8.9 legacy ebook decommission (it was
# only used by the now-removed /ebook/acces/[token] page). Kept as a documented
# placeholder in case a future flow needs a public support mailbox; safe to
# remove entirely if confirmed unused.
MAIL_TO=support@example.com

# ----------------------------------------------------------------------------
# Stripe
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret

# Legacy ebook supprimé au Sprint 8.9 : STRIPE_PRICE_ID_EBOOK,
# BLOB_READ_WRITE_TOKEN et EBOOK_ACCESS_TOKEN_SECRET ne sont plus nécessaires.
# Le nouveau commerce construit ses line_items via price_data dynamique
# (aucun Price Stripe préexistant requis) et stocke les fichiers privés dans
# Supabase Storage (voir plus bas), pas Vercel Blob.

# Public base URL used to build absolute links in server-side flows
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Supabase Storage (new commerce private digital assets)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
SUPABASE_STORAGE_BUCKET_EBOOKS=ebooks-private

# ----------------------------------------------------------------------------
# WebAuthn
# ----------------------------------------------------------------------------
# Required by the existing WebAuthn admin routes if those routes are used.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
