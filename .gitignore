# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# throwaway scratch scripts used during manual recette/QA sessions
# (may contain temporary output or secrets, never meant to be committed)
scripts/.tmp-*

# vercel
.vercel

# contenu source des ebooks (HTML/EPUB volumineux), jamais commite
/ebook/
# Brouillons premium : gardes localement pendant leur conception. Ils ne
# doivent jamais creer une route ou une image publique en production.
/app/outils/ebook-schema-fabsystem/
/public/ebook/ebook-schema-fabsystem-images/

# dossiers de travail locaux / nettoyage manuel
/dash/
/local-only/
/outputs/
/tmp/
.claude/settings.json

# client Prisma généré : régénéré à chaque `npm run build` (voir script
# "build": "prisma generate && next build") et à chaque `npm install` via
# le hook postinstall — jamais une source de vérité, committer ce dossier
# ne faisait que produire des diffs de dizaines de milliers de lignes à
# chaque changement de schéma ou de version de Prisma.
/lib/generated/

# typescript
*.tsbuildinfo
next-env.d.ts
package-lock 2.json
vercel.env.txt
